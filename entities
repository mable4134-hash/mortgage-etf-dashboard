function payLoanMonth(index){
  const list = LS.get(KEY_D);
  const item = list[index];
  if(!item) return;
  const current = parseInt(item.remainingMonths, 10);
  if(isNaN(current) || current <= 0){
    alert('尚未設定剩餘期數，或期數已還清');
    return;
  }
  item.remainingMonths = current - 1;
  LS.set(KEY_D, list);
  renderDebtPage();
}

