/* ══════════════════════════════════════
   dashboard.css（v5.5 重構）
   首頁（Dashboard）專屬卡片樣式：總覽橫幅、明細列表、概況卡片、現金流卡片、
   資產配置分析、Hero Banner、Demo 模式、新手引導、資料完整度、快速新增、
   Goals 首頁摘要連結
══════════════════════════════════════ */

/* ══ 首頁：總覽橫幅 ══ */
.summary-banner{background:linear-gradient(135deg,#0D1F1A 0%,#111827 50%,#13111F 100%);border:1px solid rgba(34,211,168,.15);border-radius:var(--r20);padding:24px;margin-bottom:16px;position:relative;overflow:hidden}
.summary-banner::before{content:'';position:absolute;top:-40px;right:-40px;width:160px;height:160px;background:radial-gradient(circle,rgba(34,211,168,.06),transparent 70%);pointer-events:none}
.summary-label{font-size:11px;color:var(--t2);letter-spacing:.8px;text-transform:uppercase;margin-bottom:4px}
.summary-net{display:flex;align-items:baseline;gap:8px;margin-bottom:20px;flex-wrap:wrap;min-width:0}
.summary-net-value{font-size:clamp(28px,10vw,48px);font-weight:800;letter-spacing:-1px;font-variant-numeric:tabular-nums;line-height:1.1;color:var(--green);text-shadow:0 0 32px rgba(34,211,168,.25);word-break:break-all;min-width:0;max-width:100%}
.summary-net-unit{font-size:16px;color:var(--t2);font-weight:500}
.summary-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;min-width:0}
.summary-block{background:rgba(255,255,255,.03);border:1px solid var(--border2);border-radius:var(--r12);padding:12px 14px;min-width:0;overflow:hidden}
.summary-block-label{font-size:10px;color:var(--tm);letter-spacing:.5px;margin-bottom:4px}
.summary-block-value{font-size:clamp(13px,4vw,20px);font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:-.3px;word-break:break-all;line-height:1.2;overflow-wrap:break-word}
.summary-block-sub{font-size:10px;color:var(--t2);margin-top:2px}

/* ══ 首頁：明細列表 ══ */
.section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;padding:0 2px}
.section-title{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:700;color:var(--t2);letter-spacing:.4px;text-transform:uppercase}
.section-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.dot--green{background:var(--green);box-shadow:0 0 5px var(--green)}
.dot--red{background:var(--red);box-shadow:0 0 5px var(--red)}
.section-total{font-size:13px;font-weight:700;font-variant-numeric:tabular-nums}
.home-section{margin-bottom:16px}
.home-section-link{font-size:12px;color:var(--green);font-weight:600;cursor:pointer;touch-action:manipulation}

/* ══ 首頁概況卡片 ══ */
.overview-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r16);overflow:hidden}
.overview-row{display:flex;align-items:center;justify-content:space-between;padding:11px 16px;border-bottom:1px solid var(--border2)}
.overview-row:last-child{border-bottom:none}
.overview-row-left{display:flex;align-items:center;gap:10px}
.overview-row-icon{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
.overview-row-name{font-size:13px;font-weight:600;color:var(--t1)}
.overview-row-count{font-size:10px;color:var(--tm);margin-top:1px}
.overview-row-right{text-align:right}
.overview-row-amount{font-size:14px;font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:-.3px}
.overview-row-pct{font-size:10px;color:var(--tm);margin-top:1px;font-variant-numeric:tabular-nums}
.overview-empty{font-size:12px;color:var(--tm);text-align:center;padding:20px}

/* ══ 現金流卡片 ══ */
.dot--cashflow{background:var(--blue);box-shadow:0 0 5px var(--blue)}
.cashflow-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r16);overflow:hidden}
.cashflow-main{padding:20px 18px 14px;display:flex;flex-direction:column;gap:4px}
.cashflow-main-label{font-size:11px;color:var(--t2);letter-spacing:.5px}
.cashflow-mortgage-subsidy-title{font-size:11px;color:var(--t2);letter-spacing:.5px;padding:14px 18px 2px}
.cashflow-main-value{font-size:clamp(28px,8vw,40px);font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:-1px;line-height:1.1;word-break:break-all}
.cashflow-main-unit{font-size:13px;color:var(--t2);font-weight:500}
.cashflow-divider{height:1px;background:var(--border2);margin:0 18px}
.cashflow-stats{display:flex;align-items:stretch;padding:12px 4px}
.cashflow-stat{flex:1;display:flex;flex-direction:column;gap:4px;padding:6px 10px;text-align:center}
.cashflow-stat-label{font-size:10px;color:var(--tm);letter-spacing:.3px;white-space:nowrap}
.cashflow-stat-value{font-size:13px;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:-.2px}
.cashflow-stat-sep{width:1px;background:var(--border2);flex-shrink:0;margin:4px 0}
.cashflow-note{font-size:11px;color:var(--tm);line-height:1.5;padding:12px 18px 16px;border-top:1px solid var(--border2)}

/* ══════════════════════════════════════
   資產配置分析（v2.0）
══════════════════════════════════════ */
.alloc-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r16);overflow:hidden}

/* 頂部摘要 */
.alloc-summary{padding:16px 18px 14px;display:flex;align-items:center;gap:10px}
.alloc-summary-icon{width:38px;height:38px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:19px;flex-shrink:0;background:var(--stat)}
.alloc-summary-text{min-width:0}
.alloc-summary-label{font-size:11px;color:var(--t2);letter-spacing:.3px;margin-bottom:2px}
.alloc-summary-value{font-size:15px;font-weight:800;color:var(--t1);letter-spacing:-.2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

/* 各資產列 */
.alloc-list{padding:2px 0}
.alloc-row{padding:12px 18px;border-top:1px solid var(--border2)}
.alloc-row-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;gap:8px}
.alloc-row-left{display:flex;align-items:center;gap:8px;min-width:0}
.alloc-row-icon{font-size:16px;flex-shrink:0}
.alloc-row-name{font-size:13px;font-weight:700;color:var(--t1);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.alloc-row-right{text-align:right;flex-shrink:0;display:flex;align-items:baseline;gap:8px}
.alloc-row-amount{font-size:12px;color:var(--t2);font-variant-numeric:tabular-nums;white-space:nowrap}
.alloc-row-pct{font-size:14px;font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:-.2px;min-width:38px;text-align:right}
.alloc-bar-bg{height:7px;background:var(--stat);border-radius:99px;overflow:hidden}
.alloc-bar-fill{height:100%;border-radius:99px;width:0%;transition:width .8s cubic-bezier(.34,1.56,.64,1)}

/* 集中度提醒 */
.alloc-alert{margin:10px 18px 16px;padding:10px 12px;border-radius:var(--r12);font-size:12px;font-weight:600;line-height:1.5}
.alloc-alert--warn{color:var(--orange);background:var(--obg);border:1px solid rgba(249,115,22,.2)}
.alloc-alert--ok{color:var(--green);background:var(--gbg);border:1px solid rgba(34,211,168,.2)}

/* ══════════════════════════════════════
   🏠 Hero Banner（v4.1，純展示用途）
══════════════════════════════════════ */
.hero-banner{background:linear-gradient(150deg,#0D1F1A 0%,#111827 45%,#13111F 100%);border:1px solid rgba(34,211,168,.18);border-radius:var(--r20);padding:32px 24px;margin-bottom:16px;text-align:center;position:relative;overflow:hidden}
.hero-banner::before{content:'';position:absolute;top:-60px;left:-60px;width:200px;height:200px;background:radial-gradient(circle,rgba(56,189,248,.08),transparent 70%);pointer-events:none}
.hero-icon{font-size:38px;line-height:1;margin-bottom:10px}
.hero-title{font-size:20px;font-weight:800;color:var(--t1);letter-spacing:-.3px;margin-bottom:10px}
.hero-sub{font-size:13px;color:var(--t2);line-height:1.7;margin-bottom:20px}
.hero-cta{padding:14px 36px;background:linear-gradient(135deg,#064E3B,#047857);color:var(--green);font-size:15px;font-weight:700;border-radius:var(--r12);border:1px solid rgba(34,211,168,.25);touch-action:manipulation;box-shadow:0 0 20px rgba(34,211,168,.12)}
.hero-cta:active{opacity:.85}

/* ══════════════════════════════════════
   👀 Demo 模式（v4.1）
══════════════════════════════════════ */
.demo-section{background:var(--card);border:1px solid var(--border);border-radius:var(--r16);padding:16px 18px;margin-bottom:16px}
.demo-header{font-size:13px;font-weight:700;color:var(--t1);margin-bottom:10px}
.demo-badge{font-size:11px;font-weight:600;color:var(--orange);background:var(--obg);border:1px solid rgba(249,115,22,.2);border-radius:20px;padding:6px 12px;display:inline-block;margin-bottom:10px}
.demo-buttons{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.demo-btn{padding:12px;border-radius:var(--r12);font-size:12px;font-weight:700;touch-action:manipulation;border:1px solid var(--border)}
.demo-btn--primary{background:linear-gradient(135deg,#064E3B,#047857);color:var(--green);border-color:rgba(34,211,168,.2)}
.demo-btn--primary:active{opacity:.85}
.demo-btn--secondary{background:var(--stat);color:var(--t2)}
.demo-btn--secondary:active{opacity:.8}

/* ══════════════════════════════════════
   新手引導 Onboarding（v4.0）
══════════════════════════════════════ */
.onboarding-card{background:linear-gradient(135deg,#0D1F1A 0%,#111827 50%,#13111F 100%);border:1px solid rgba(34,211,168,.2);border-radius:var(--r20);padding:24px;margin-bottom:16px;text-align:center}
.onboarding-icon{font-size:36px;line-height:1;margin-bottom:8px}
.onboarding-title{font-size:16px;font-weight:800;color:var(--t1);margin-bottom:6px}
.onboarding-sub{font-size:12px;color:var(--t2);margin-bottom:16px;line-height:1.6}
.onboarding-steps{display:flex;flex-direction:column;gap:8px;text-align:left;background:rgba(255,255,255,.03);border:1px solid var(--border2);border-radius:var(--r12);padding:14px 16px;margin-bottom:16px}
.onboarding-step{font-size:13px;color:var(--t1);display:flex;align-items:center;gap:8px}
.onboarding-step-num{font-weight:800;color:var(--green);flex-shrink:0}
.onboarding-cta{width:100%;padding:14px;background:linear-gradient(135deg,#064E3B,#047857);color:var(--green);font-size:15px;font-weight:700;border-radius:var(--r12);border:1px solid rgba(34,211,168,.2);touch-action:manipulation}
.onboarding-cta:active{opacity:.85}

/* ══════════════════════════════════════
   資料完整度（v4.0）
══════════════════════════════════════ */
.completeness-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r16);padding:16px 18px}
.completeness-list{display:grid;grid-template-columns:1fr 1fr;gap:10px 16px;margin-top:14px}
.completeness-row{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--t2)}

/* ══════════════════════════════════════
   快速新增（v4.0）
══════════════════════════════════════ */
.quickadd-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.quickadd-btn{display:flex;align-items:center;justify-content:center;gap:6px;padding:14px;background:var(--card);border:1px solid var(--border);border-radius:var(--r12);color:var(--t1);font-size:13px;font-weight:700;touch-action:manipulation;transition:border-color .15s,color .15s}
.quickadd-btn:active{border-color:var(--green);color:var(--green)}
.quickadd-icon{font-size:14px}

/* Goals 首頁摘要 */
.goal-summary-row{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:var(--card);border:1px solid var(--border);border-radius:var(--r12);margin-bottom:8px}
.goal-summary-left{display:flex;align-items:center;gap:10px}
.goal-summary-icon{font-size:18px;width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;background:var(--stat)}
.goal-summary-name{font-size:13px;font-weight:600;color:var(--t1)}
.goal-summary-right{display:flex;align-items:center;gap:10px}
.goal-summary-pct{font-size:14px;font-weight:800;font-variant-numeric:tabular-nums}
.goal-mini-bar-bg{width:60px;height:5px;background:var(--stat);border-radius:99px;overflow:hidden}
.goal-mini-bar-fill{height:100%;border-radius:99px}
/* ══════════════════════════════════════
   cashflow.css（v5.5 重構）
   收入／固定支出／每月生活費（工具頁）專屬樣式
   （對應 cashflow.js：renderIncomePage／renderExpensePage／renderLivingExpense 等；
   此模組為既有程式碼中「收入支出」相關 UI 的獨立分類，原規格建議架構未列出對應 CSS 檔名，
   依高內聚原則獨立拆分，避免與 dashboard.css 混雜）
══════════════════════════════════════ */

/* ══ 工具頁：收入橫幅 ══ */
.income-banner{background:linear-gradient(135deg,#0D1F1A 0%,#111827 100%);border:1px solid rgba(34,211,168,.15);border-radius:var(--r20);padding:20px 24px;margin-bottom:16px}

/* ══ 工具頁：支出橫幅 ══ */
.expense-banner{background:linear-gradient(135deg,#1F1200 0%,#111827 100%);border:1px solid rgba(249,115,22,.15);border-radius:var(--r20);padding:20px 24px;margin-bottom:16px}

/* ══════════════════════════════════════
   每月生活費（v2.1）
══════════════════════════════════════ */
.living-banner{background:linear-gradient(135deg,#1C1535 0%,#111827 100%);border:1px solid rgba(167,139,250,.15);border-radius:var(--r20);padding:20px 24px;margin-bottom:16px}
.living-edit-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r16);padding:16px 18px;margin-bottom:16px}
